<?xml version="1.0" encoding="utf-8"?>
<com.vanvatcorporation.doubleclips.activities.template.TemplateExportPropertiesAreaScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editSpecificArea"
    android:layout_below="@id/timestampBar"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/windowBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:shapeAppearanceOverlay="@style/lowerRoundedImageView"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="0.5dp" />

    <!-- Header bar -->
    <RelativeLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_drag_handle"
            android:alpha="0.35" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Export Clip"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/closeWindowButton"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="4dp"
            app:icon="@drawable/baseline_close_24"
            app:iconTint="?android:attr/textColorSecondary"
            app:iconSize="20dp" />

    </RelativeLayout>

    <View
        android:id="@+id/headerDivider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_below="@id/headerBar"
        android:background="?attr/colorOutlineVariant" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerDivider"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp"
            android:layout_marginTop="16dp">

            <!-- File info header card -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="24dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/previewImage"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:scaleType="centerCrop"
                    android:background="?attr/colorSurfaceVariant"
                    app:shapeAppearanceOverlay="@style/roundedImageView"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="0.5dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/previewImage"
                    android:layout_toStartOf="@id/moreButton"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/titleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="clip 1" />

                    <TextView
                        android:id="@+id/dataInfoText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="JPEG Image" />

                    <TextView
                        android:id="@+id/lengthText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:text="3s" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/moreButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/baseline_more_vert_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="?android:attr/textColorSecondary"
                    android:contentDescription="More options" />

            </RelativeLayout>

            <com.vanvatcorporation.doubleclips.impl.SectionView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:sectionTitle="Trim Video">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="16dp"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/trimText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trim"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.slider.RangeSlider
                        android:id="@+id/trimRangeSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:labelBehavior="floating"
                        app:thumbColor="@color/ios_blue"
                        app:trackColorActive="@color/ios_blue"
                        app:trackColorInactive="?attr/colorSurfaceVariant"
                        android:valueFrom="0"
                        android:valueTo="10000" />

                </LinearLayout>

            </com.vanvatcorporation.doubleclips.impl.SectionView>

        </LinearLayout>
    </ScrollView>

</com.vanvatcorporation.doubleclips.activities.template.TemplateExportPropertiesAreaScreen>
