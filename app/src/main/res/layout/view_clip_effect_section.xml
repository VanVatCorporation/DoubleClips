<?xml version="1.0" encoding="utf-8"?>
<!-- The "Effect" section of a clip's editor: an effect for THIS clip only (Clip.clipEffect). Shared by the clip and the text screens,
     driven by activities/editing/ClipEffectPicker. -->
<com.vanvatcorporation.doubleclips.impl.SectionView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clipEffectSection"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:sectionTitle="Effect">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/clipEffectIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_centerVertical="true"
            android:src="@drawable/baseline_auto_fix_high_24"
            app:tint="@color/ios_blue" />

        <TextView
            android:id="@+id/clipEffectLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/clipEffectIcon"
            android:layout_marginStart="12dp"
            android:text="@string/clip_effect"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/clipEffectContent"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:layout_toEndOf="@id/clipEffectLabel"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical|end"
            android:maxLines="1"
            android:text="@string/none"
            android:textColor="@color/ios_blue"
            android:textSize="15sp" />

    </RelativeLayout>

    <!-- When the effect shows inside the clip (hidden while there is no effect) -->
    <LinearLayout
        android:id="@+id/clipEffectTimingGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="50dp"
                    android:background="?attr/colorOutlineVariant" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:id="@+id/clipEffectStartIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/baseline_timer_24"
                        app:tint="@color/ios_blue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/clipEffectStartIcon"
                        android:layout_marginStart="12dp"
                        android:text="@string/start_s"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/clipEffectStartContent"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@null"
                        android:gravity="end"
                        android:hint="0"
                        android:imeOptions="actionDone"
                        android:inputType="numberDecimal"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="15sp" />

                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="50dp"
                    android:background="?attr/colorOutlineVariant" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:id="@+id/clipEffectDurationIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/baseline_timer_24"
                        app:tint="@color/ios_blue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/clipEffectDurationIcon"
                        android:layout_marginStart="12dp"
                        android:text="@string/duration_s"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/clipEffectDurationContent"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@null"
                        android:gravity="end"
                        android:hint="@string/clip_length"
                        android:imeOptions="actionDone"
                        android:inputType="numberDecimal"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="15sp" />

                </RelativeLayout>

    </LinearLayout>

    <!-- Strength row (hidden for an effect with nothing to scale); the keyframe diamond is added after the value -->
    <LinearLayout
        android:id="@+id/clipEffectStrengthGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="50dp"
            android:background="?attr/colorOutlineVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/baseline_auto_fix_high_24"
                app:tint="@color/ios_blue" />

            <TextView
                android:id="@+id/clipEffectStrengthText"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:maxLines="1"
                android:text="@string/strength"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/clipEffectStrengthContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" />

            <TextView
                android:id="@+id/clipEffectStrengthValue"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="1.00x"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="15sp" />

        </LinearLayout>
    </LinearLayout>

</com.vanvatcorporation.doubleclips.impl.SectionView>
