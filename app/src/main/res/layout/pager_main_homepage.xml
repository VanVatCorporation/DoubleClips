<?xml version="1.0" encoding="utf-8"?>
<com.vanvatcorporation.doubleclips.activities.main.MainAreaScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Header Frame -->
    <RelativeLayout
        android:id="@+id/titleFrame"
        android:layout_width="match_parent"
        android:layout_height="180dp">

        <!-- Header Background Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="0dp"
            app:cardElevation="@dimen/elevation_2"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.App.BottomRounded"
            app:strokeWidth="0dp" />

        <!-- Header Content -->
        <LinearLayout
            android:id="@+id/headerContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_base"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_base">

            <!-- Welcome Title -->
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/welcome"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                android:textColor="?attr/colorOnPrimaryContainer" />

            <!-- Add Project Button -->
            <Button
                android:id="@+id/addProjectButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_base"
                android:minHeight="@dimen/button_height_large"
                android:text="@string/add_project"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                app:icon="@android:drawable/ic_input_add"
                app:iconGravity="start" />

        </LinearLayout>

    </RelativeLayout>

    <!-- Projects List with Swipe Refresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/titleFrame"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:layout_marginBottom="@dimen/spacing_sm">

        <!-- List Container Card -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Background Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="@dimen/corner_base"
                app:cardElevation="@dimen/elevation_0"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp" />

            <!-- Projects RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/projectList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="@dimen/spacing_sm"
                android:scrollbars="vertical" />

        </RelativeLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Loading Indicator -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressBarFetchingBook"
        style="@style/Widget.App.CircularProgressIndicator"
        android:layout_width="@dimen/progress_indicator_size_md"
        android:layout_height="@dimen/progress_indicator_size_md"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="?attr/colorPrimary" />

</com.vanvatcorporation.doubleclips.activities.main.MainAreaScreen>