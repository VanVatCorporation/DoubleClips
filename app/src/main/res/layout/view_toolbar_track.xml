<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbarScrollView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    android:background="?android:attr/colorBackground"
    android:elevation="16dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:background="?android:attr/colorBackground"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/track"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />
        <!-- reuse rounded bg @drawable/bg_search_bar -->

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/addMediaButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_perm_media_24"
            app:navText="@string/add" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/deleteTrackButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_delete_24"
            app:navText="@string/delete" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/splitMediaButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_content_cut_24"
            app:navText="@string/split" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/addTextButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_text_increase_24"
            app:navText="@string/text" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/addEffectButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_bubble_chart_24"
            app:navText="@string/effect" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/copyMediaButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_content_copy_24"
            app:navText="@string/copy" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/pasteMediaButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_content_paste_24"
            app:navText="@string/paste" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/selectAllButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_select_all_24"
            app:navText="@string/select_all" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/autoSnapButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_commit_24"
            app:navText="@string/autosnap" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/importClipButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_data_object_24"
            app:navText="@string/add_project_choice_import" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/exportTrackButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_upload_file_24"
            app:navText="@string/export_3" />

    </LinearLayout>
</HorizontalScrollView>