<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:layout_marginStart="3dp"
    android:layout_marginEnd="3dp"
    android:gravity="center">
    <com.google.android.material.imageview.ShapeableImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"


        android:background="@color/colorPalette1_4"

        app:strokeColor="@color/colorGlassBackground"
        app:strokeWidth="1dp"
        app:shapeAppearanceOverlay="@style/roundedImageView"/>


    <RelativeLayout
        android:id="@+id/previewLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/previewImage"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:scaleType="centerCrop"


            android:background="@color/colorGlassBackground"

            app:strokeColor="@color/colorPrimaryBackground"
            app:strokeWidth="0dp"
            app:shapeAppearanceOverlay="@style/roundedImageView"/>


        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:orientation="horizontal"
            android:layout_marginStart="10dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="5dp"
            android:layout_alignBottom="@id/previewImage"
            android:gravity="center">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"

                android:layout_alignStart="@id/templateInfoLayout"
                android:layout_alignEnd="@id/templateInfoLayout"


                android:background="@color/colorGlassBackground"

                app:strokeColor="@color/colorPrimaryBackground"
                app:strokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/rounded4pxImageView"/>


            <LinearLayout
                android:id="@+id/templateInfoLayout"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/baseline_preview_24"/>
                <TextView
                    android:id="@+id/viewCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/colorPrimaryButton"
                    android:text="3M" />

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/baseline_favorite_24"/>
                <TextView
                    android:id="@+id/heartCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/colorPrimaryButton"
                    android:text="83.4k" />

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/baseline_web_stories_24"/>
                <TextView
                    android:id="@+id/useCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/colorPrimaryButton"
                    android:text="25k" />

            </LinearLayout>

        </RelativeLayout>


    </RelativeLayout>

    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="0dp"
        android:layout_below="@id/previewLayout"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/colorPrimaryButton"
        android:text="replacable template name" />
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/titleText">

        <TextView
            android:id="@+id/authorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="0dp"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/authorAvatar"
            android:textSize="12sp"
            android:textStyle="italic"
            android:textColor="@color/colorPrimaryButton"
            android:text="\@authorname" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/authorAvatar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="5dp"
            android:scaleType="centerCrop"


            android:background="@color/colorGlassBackground"

            app:strokeColor="@color/colorPrimaryBackground"
            app:strokeWidth="0dp"
            app:shapeAppearanceOverlay="@style/rounded4pxImageView"/>

    </RelativeLayout>



</RelativeLayout>