<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_xs"
    android:layout_marginTop="@dimen/spacing_xs"
    android:layout_marginEnd="@dimen/spacing_xs"
    android:layout_marginBottom="@dimen/spacing_xs">

    <!-- Template Card -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Material3.CardView.Elevated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="@dimen/corner_base"
        app:cardElevation="@dimen/elevation_1"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="0.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Preview Image Container -->
            <RelativeLayout
                android:id="@+id/previewLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_sm">

                <!-- Preview Image -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/previewImage"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="?attr/colorSurfaceContainer"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.MediumRounded"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="0.5dp" />

                <!-- Stats Overlay -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/statsOverlay"
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBottom="@id/previewImage"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    app:cardBackgroundColor="#E6000000"
                    app:cardCornerRadius="@dimen/corner_sm"
                    app:cardElevation="@dimen/elevation_0">

                    <LinearLayout
                        android:id="@+id/templateInfoLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/spacing_sm"
                        android:paddingTop="@dimen/spacing_xs"
                        android:paddingEnd="@dimen/spacing_sm"
                        android:paddingBottom="@dimen/spacing_xs">

                        <!-- View Count -->
                        <ImageView
                            android:layout_width="@dimen/icon_size_xs"
                            android:layout_height="@dimen/icon_size_xs"
                            android:src="@drawable/baseline_preview_24"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/viewCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="@dimen/spacing_sm"
                            android:text="3M"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:textColor="@color/white" />

                        <!-- Heart/Like Count -->
                        <ImageView
                            android:layout_width="@dimen/icon_size_xs"
                            android:layout_height="@dimen/icon_size_xs"
                            android:src="@drawable/baseline_favorite_24"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/heartCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="@dimen/spacing_sm"
                            android:text="83.4k"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:textColor="@color/white" />

                        <!-- Use Count -->
                        <ImageView
                            android:layout_width="@dimen/icon_size_xs"
                            android:layout_height="@dimen/icon_size_xs"
                            android:src="@drawable/baseline_web_stories_24"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/useCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:text="25k"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:textColor="@color/white" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </RelativeLayout>

            <!-- Template Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_base"
                android:paddingTop="@dimen/spacing_sm"
                android:paddingEnd="@dimen/spacing_base"
                android:paddingBottom="@dimen/spacing_base">

                <!-- Title -->
                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Replaceable template name"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <!-- Author Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Author Avatar -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/authorAvatar"
                        android:layout_width="@dimen/avatar_size_xs"
                        android:layout_height="@dimen/avatar_size_xs"
                        android:background="?attr/colorSurfaceContainer"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle"
                        app:strokeColor="?attr/colorOutline"
                        app:strokeWidth="0.5dp" />

                    <!-- Author Name -->
                    <TextView
                        android:id="@+id/authorText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="\@authorname"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>