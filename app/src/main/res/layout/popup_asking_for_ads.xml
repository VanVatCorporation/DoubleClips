<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- Title -->
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginBottom="16dp"
            android:text="@string/alert_ask_for_showing_ads_title"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"/>

        <!-- Description -->
        <TextView
            android:id="@+id/adsDescriptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginBottom="24dp"
            android:text="@string/alert_ask_for_showing_ads_description"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="?android:attr/textColorSecondary"
            android:lineSpacingMultiplier="1.4"/>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <!-- Rewarded Ads (Blue / Primary) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/rewardedAdsButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_ask_for_showing_ads_reward"
                android:textSize="15sp"
                android:textColor="@color/white"
                app:backgroundTint="@color/ios_blue"
                app:cornerRadius="12dp"
                android:layout_marginBottom="12dp"/>

            <!-- Interstitial Ads (Secondary / Teal) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/interstitialAdsButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_ask_for_showing_ads_interstitial"
                android:textSize="15sp"
                android:textColor="@color/white"
                app:backgroundTint="?attr/colorSecondary"
                app:cornerRadius="12dp"
                android:layout_marginBottom="12dp"/>

            <!-- Decline (Reddish) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/declineAdsButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_ask_for_showing_ads_decline"
                android:textSize="15sp"
                android:textColor="@color/white"
                app:backgroundTint="#CC3B30"
                app:cornerRadius="12dp"
                android:layout_marginBottom="20dp"/>

        </LinearLayout>

        <!-- Tip text -->
        <TextView
            android:id="@+id/adsTurnOffGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/alert_ask_for_showing_ads_disable_guide"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="?android:attr/textColorSecondary"/>

    </LinearLayout>
</ScrollView>
