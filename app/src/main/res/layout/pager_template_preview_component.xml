<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/black">

    <!-- 1. Media Layer -->
    <ImageView
        android:id="@+id/thumbnailView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:background="#121212"
        android:scaleType="fitCenter" />

    <SurfaceView
        android:id="@+id/previewSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:visibility="gone"/>

    <!-- 2. Gradient Overlay for Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/gradient_bottom_overlay"/>

    <!-- 3. Right Action Bar -->
    <LinearLayout
        android:id="@+id/rightActionZone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="100dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:elevation="10dp">

        <!-- Heart -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="24dp">
            <ImageButton
                android:id="@+id/heartButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/baseline_favorite_border_24"
                app:tint="@android:color/white"
                android:scaleType="fitCenter"
                android:padding="2dp"/>
            <TextView
                android:id="@+id/heartCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15k"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"/>
        </LinearLayout>

        <!-- Comment -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="24dp">
            <ImageButton
                android:id="@+id/commentButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/baseline_comment_24"
                app:tint="@android:color/white"
                android:scaleType="fitCenter"
                android:padding="2dp"/>
            <TextView
                android:id="@+id/commentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="787"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"/>
        </LinearLayout>

        <!-- Bookmark -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="24dp">
            <ImageButton
                android:id="@+id/bookmarkButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/baseline_bookmark_border_24"
                app:tint="@android:color/white"
                android:scaleType="fitCenter"
                android:padding="2dp"/>
            <TextView
                android:id="@+id/bookmarkCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2k"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"/>
        </LinearLayout>

        <!-- Other/Menu -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <ImageButton
                android:id="@+id/otherButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/baseline_menu_24"
                app:tint="@android:color/white"
                android:scaleType="fitCenter"
                android:padding="2dp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- 4. Bottom Info Zone -->
    <LinearLayout
        android:id="@+id/bottomZone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@id/rightActionZone"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <!-- User Info -->
        <TextView
            android:id="@+id/usernameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\@viet2007ht"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="8dp"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"/>

        <!-- Metadata Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/baseline_local_movies_24"
                app:tint="@android:color/white"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:id="@+id/replacementClipCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="42 clips"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:layout_marginEnd="12dp"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"/>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/baseline_hourglass_bottom_24"
                app:tint="@android:color/white"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:id="@+id/durationClipCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02:32"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"/>

        </LinearLayout>

        <!-- Use Template Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/useTemplateButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Use template"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/white"
            app:backgroundTint="@color/ios_blue"
            app:cornerRadius="28dp"
            android:layout_marginEnd="16dp"
            android:elevation="4dp"/>

    </LinearLayout>

    <!-- Hidden / Minimal Timeline for now (as requested to just refine aesthetic first) -->
    <View
        android:id="@+id/playhead"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

</RelativeLayout>