<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy "all" toolbar — brought up to iOS/M3 styling -->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbarScrollView"
    android:layout_width="match_parent"
    android:layout_height="66dp"
    android:scrollbars="none"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/addMediaButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="7dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/baseline_perm_media_24"
            app:tint="?android:attr/textColorPrimary" />

        <ImageView
            android:id="@+id/deleteMediaButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="7dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/baseline_delete_24"
            app:tint="?android:attr/textColorPrimary" />

        <ImageView
            android:id="@+id/splitMediaButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="7dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/baseline_content_cut_24"
            app:tint="?android:attr/textColorPrimary" />

        <ImageView
            android:id="@+id/addTextButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="7dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/baseline_text_increase_24"
            app:tint="?android:attr/textColorPrimary" />

        <ImageView
            android:id="@+id/addEffectButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="7dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/baseline_bubble_chart_24"
            app:tint="?android:attr/textColorPrimary" />

        <ImageView
            android:id="@+id/editMediaButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="7dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/baseline_edit_square_24"
            app:tint="?android:attr/textColorPrimary" />

        <ImageView
            android:id="@+id/addKeyframeButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="7dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/round_auto_awesome_24"
            app:tint="?android:attr/textColorPrimary" />

        <ImageView
            android:id="@+id/selectMultipleButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="7dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/baseline_menu_24"
            app:tint="?android:attr/textColorPrimary" />

        <ImageView
            android:id="@+id/selectAllButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="7dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/baseline_select_all_24"
            app:tint="?android:attr/textColorPrimary" />

        <ImageView
            android:id="@+id/autoSnapButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="7dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/baseline_commit_24"
            app:tint="?android:attr/textColorPrimary" />

    </LinearLayout>
</HorizontalScrollView>