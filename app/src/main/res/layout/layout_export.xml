<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:id="@+id/modifyZone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_alignParentTop="true">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/baseline_keyboard_return_24" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_toEndOf="@id/backButton"
                android:src="@drawable/baseline_display_settings_24" />



            <Button
                android:id="@+id/exportAsTemplateButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/exportButton"
                android:text="@string/export_template" />

            <Button
                android:id="@+id/exportButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="@string/export_2" />

        </RelativeLayout>


        <RadioGroup
            android:id="@+id/renderEngineRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/top_bar"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <RadioButton
                android:id="@+id/renderEngineFfmpegRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/ffmpeg_cpu" />

            <RadioButton
                android:id="@+id/renderEngineOpenGlRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/opengl_gpu_recommended" />

        </RadioGroup>


        <!-- What the export will make, and how big (the same summary as the iOS and Desktop export screens). -->
        <com.vanvatcorporation.doubleclips.impl.SectionView
            android:id="@+id/outputSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/renderEngineRadioGroup"
            app:isOpenAtStart="true"
            app:sectionTitle="@string/export_summary_title">

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:stretchColumns="1">

            <TableRow android:paddingTop="4dp" android:paddingBottom="4dp">

                <TextView
                    android:text="@string/export_summary_resolution"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/outputResolution"
                    android:gravity="end"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp" />
            </TableRow>
            <TableRow android:paddingTop="4dp" android:paddingBottom="4dp">

                <TextView
                    android:text="@string/export_summary_frame_rate"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/outputFrameRate"
                    android:gravity="end"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp" />
            </TableRow>
            <TableRow android:paddingTop="4dp" android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/outputQualityLabel"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/outputQuality"
                    android:gravity="end"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp" />
            </TableRow>
            <TableRow android:paddingTop="4dp" android:paddingBottom="4dp">

                <TextView
                    android:text="@string/export_summary_duration"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/outputDuration"
                    android:gravity="end"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp" />
            </TableRow>
            <TableRow android:paddingTop="4dp" android:paddingBottom="4dp">

                <TextView
                    android:text="@string/export_summary_format"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/outputFormat"
                    android:gravity="end"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp" />
            </TableRow>
            <TableRow android:paddingTop="4dp" android:paddingBottom="4dp">

                <TextView
                    android:text="@string/export_summary_estimated_size"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/outputEstimate"
                    android:gravity="end"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </TableRow>
            </TableLayout>

            <TextView
                android:id="@+id/outputEstimateNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="@string/export_summary_rough_note"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp"
                android:visibility="gone" />
        </com.vanvatcorporation.doubleclips.impl.SectionView>


        <com.vanvatcorporation.doubleclips.impl.SectionView
            android:id="@+id/advancedSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/outputSection"
            app:sectionTitle="@string/advanced">
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">


                <Button
                    android:id="@+id/generateCmdButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gen_cmd" />

                <Button
                    android:id="@+id/generateTemplateCmdButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/generateCmdButton"
                    android:text="@string/gen_template_cmd" />
            </RelativeLayout>

            <EditText
                android:id="@+id/exportCommand"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:gravity="top"
                android:hint="@string/ffmpeg_command"
                android:scrollbarSize="20dp"
                android:textSize="12sp" />


        </com.vanvatcorporation.doubleclips.impl.SectionView>


    </RelativeLayout>



    <com.vanvatcorporation.doubleclips.impl.SectionView
        android:id="@+id/logSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/modifyZone"
        app:sectionTitle="@string/log">



        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_task_0"
                android:textSize="15sp" />

            <ProgressBar
                android:id="@+id/statusBar"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp" />
        </RelativeLayout>


        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/globalStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remaining_task_0_0"
                android:textSize="15sp" />

            <ProgressBar
                android:id="@+id/globalStatusBar"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp" />
        </RelativeLayout>


        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <CheckBox
                android:id="@+id/logCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enable_log" />

            <CheckBox
                android:id="@+id/truncateCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/logCheckbox"
                android:checked="true"
                android:text="@string/truncate_log" />

            <CheckBox
                android:id="@+id/scrollLockCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/truncateCheckbox"
                android:checked="true"
                android:text="@string/scroll_lock" />
        </RelativeLayout>


        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/logCheckbox"
            android:scrollbarSize="25dp">

            <TextView
                android:id="@+id/logText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/export_2"
                android:textIsSelectable="true"
                android:textSize="15sp" />

        </ScrollView>


    </com.vanvatcorporation.doubleclips.impl.SectionView>




</RelativeLayout>