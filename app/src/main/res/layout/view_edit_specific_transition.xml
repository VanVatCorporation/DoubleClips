<?xml version="1.0" encoding="utf-8"?>
<com.vanvatcorporation.doubleclips.activities.editing.TransitionEditSpecificAreaScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editSpecificArea"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_below="@id/timestampBar">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/windowBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:shapeAppearanceOverlay="@style/lowerRoundedImageView"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="0.5dp" />

    <!-- Header bar -->
    <RelativeLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_drag_handle"
            android:alpha="0.35" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Transition"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <!-- Apply to all button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/applyAllButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/closeWindowButton"
            android:text="Apply All"
            android:textColor="@color/ios_blue"
            android:textSize="14sp"
            app:rippleColor="@color/ios_blue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/closeWindowButton"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="4dp"
            app:icon="@drawable/baseline_close_24"
            app:iconTint="?android:attr/textColorSecondary"
            app:iconSize="20dp" />

    </RelativeLayout>

    <View
        android:id="@+id/headerDivider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_below="@id/headerBar"
        android:background="?attr/colorOutlineVariant" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerDivider"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <com.vanvatcorporation.doubleclips.impl.SectionView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:sectionTitle="Transition">

                <!-- Transition type row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/baseline_flip_to_front_24"
                        app:tint="@color/ios_blue" />

                    <TextView
                        android:id="@+id/transitionText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="34dp"
                        android:text="Type"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp" />

                    <Spinner
                        android:id="@+id/transitionContent"
                        android:layout_width="180dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@null"
                        android:textSize="15sp" />

                </RelativeLayout>

                <View android:layout_width="match_parent" android:layout_height="0.5dp"
                    android:layout_marginStart="50dp" android:background="?attr/colorOutlineVariant"/>

                <!-- Transition mode row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/baseline_tune_24"
                        app:tint="@color/ios_blue" />

                    <TextView
                        android:id="@+id/transitionModeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="34dp"
                        android:text="Mode"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp" />

                    <Spinner
                        android:id="@+id/transitionModeContent"
                        android:layout_width="180dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@null"
                        android:textSize="15sp" />

                </RelativeLayout>

                <View android:layout_width="match_parent" android:layout_height="0.5dp"
                    android:layout_marginStart="50dp" android:background="?attr/colorOutlineVariant"/>

                <!-- Duration row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/baseline_timer_24"
                        app:tint="@color/ios_blue" />

                    <TextView
                        android:id="@+id/durationText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="34dp"
                        android:text="Duration"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/durationContent"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@null"
                        android:gravity="end"
                        android:hint="0.5"
                        android:inputType="numberDecimal"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="15sp" />

                </RelativeLayout>

            </com.vanvatcorporation.doubleclips.impl.SectionView>

        </LinearLayout>
    </ScrollView>

</com.vanvatcorporation.doubleclips.activities.editing.TransitionEditSpecificAreaScreen>