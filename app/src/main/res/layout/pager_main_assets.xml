<?xml version="1.0" encoding="utf-8"?>
<com.vanvatcorporation.doubleclips.activities.main.AssetsAreaScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header title (same as the Template and Storage tabs) -->
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/assets_title"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <com.vanvatcorporation.doubleclips.assets.AssetsBrowserView
            android:id="@+id/assetsBrowser"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</com.vanvatcorporation.doubleclips.activities.main.AssetsAreaScreen>
