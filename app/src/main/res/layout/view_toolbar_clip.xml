<?xml version="1.0" encoding="utf-8"?>
<!-- Clip toolbar: shown when a single clip is selected -->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbarScrollView"
    android:layout_width="match_parent"
    android:layout_height="66dp"
    android:scrollbars="none"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- Context label -->
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:text="Clip"
            android:textColor="@color/ios_blue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Vertical divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginEnd="4dp" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/deleteMediaButton"
            android:layout_width="64dp"
            android:layout_height="60dp"
            app:navIcon="@drawable/baseline_delete_24"
            app:navText="Delete" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/splitMediaButton"
            android:layout_width="64dp"
            android:layout_height="60dp"
            app:navIcon="@drawable/baseline_content_cut_24"
            app:navText="Split" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/cloneMediaButton"
            android:layout_width="64dp"
            android:layout_height="60dp"
            app:navIcon="@drawable/baseline_file_copy_24"
            app:navText="Clone" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/editMediaButton"
            android:layout_width="64dp"
            android:layout_height="60dp"
            app:navIcon="@drawable/baseline_edit_square_24"
            app:navText="Edit" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/addKeyframeButton"
            android:layout_width="64dp"
            android:layout_height="60dp"
            app:navIcon="@drawable/round_auto_awesome_24"
            app:navText="Keyframe" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/selectMultipleButton"
            android:layout_width="64dp"
            android:layout_height="60dp"
            app:navIcon="@drawable/baseline_menu_24"
            app:navText="Multi-Select" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/applyKeyframeToAllClip"
            android:layout_width="64dp"
            android:layout_height="60dp"
            app:navIcon="@drawable/baseline_merge_24"
            app:navText="All Keys" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/restateButton"
            android:layout_width="64dp"
            android:layout_height="60dp"
            app:navIcon="@drawable/baseline_restore_24"
            app:navText="Restate" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/exportClipButton"
            android:layout_width="64dp"
            android:layout_height="60dp"
            app:navIcon="@drawable/baseline_upload_file_24"
            app:navText="Export" />

    </LinearLayout>
</HorizontalScrollView>