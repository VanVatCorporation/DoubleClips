<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbarScrollView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    android:background="?android:attr/colorBackground"
    android:elevation="16dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:background="?android:attr/colorBackground"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="Clips"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />
        <!-- reuse rounded bg @drawable/bg_search_bar -->

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/deleteMediaButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_delete_24"
            app:navText="Delete" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/cloneMediaButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_file_copy_24"
            app:navText="Clone" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/editMediaButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_edit_square_24"
            app:navText="Edit" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/selectMultipleButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_menu_24"
            app:navText="Multi" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/applyKeyframeToAllClip"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_merge_24"
            app:navText="All Keys" />

        <com.vanvatcorporation.doubleclips.impl.NavigationIconLayout
            android:id="@+id/restateButton"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            app:navIcon="@drawable/baseline_restore_24"
            app:navText="Restate" />

    </LinearLayout>
</HorizontalScrollView>