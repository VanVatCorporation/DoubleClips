<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/settings_group_general">

        <ListPreference
            app:key="theme_mode"
            app:title="@string/dark_mode"
            app:summary="@string/select"
            app:entries="@array/options_array"
            app:entryValues="@array/options_values"
            app:defaultValue="option1" />

        <!-- System Default first, then the languages by name (each in its own language); filled in by SettingsFragment -->
        <ListPreference
            app:key="app_language"
            app:title="@string/settings_general_language"
            app:dialogTitle="@string/settings_general_language"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="system" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="ads_popup"
            android:title="@string/settings_general_ads_popup" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="early_access_issues_notification"
            android:title="@string/settings_general_early_access_issues_notification" />

        <!-- What was hidden in the Assets tab and in the template preview, with a way back; the summary is filled in by SettingsFragment -->
        <Preference
            android:key="hidden_content"
            android:persistent="false"
            android:title="@string/hidden_content_title" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/van_vat_drive">

        <!-- Lives on the account (shared with the web and the Drive apps), so it is not stored on this device. -->
        <SwitchPreference
            android:defaultValue="true"
            android:key="drive_preview_thumbnails"
            android:persistent="false"
            android:summary="@string/shows_small_previews_of_your_image"
            android:title="@string/preview_thumbnails" />

        <Preference
            android:key="drive_terms"
            android:title="@string/terms_of_service">
            <intent android:action="android.intent.action.VIEW" android:data="https://drive.vanvatcorp.com/terms" />
        </Preference>

        <Preference
            android:key="drive_privacy"
            android:title="@string/privacy_policy">
            <intent android:action="android.intent.action.VIEW" android:data="https://drive.vanvatcorp.com/privacy" />
        </Preference>

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/licenses_group_about">

        <!-- The third-party software inside the app and its licences (LicensesActivity) -->
        <Preference
            android:key="open_source_licenses"
            android:persistent="false"
            android:title="@string/open_source_licenses"
            android:summary="@string/licenses_summary" />

    </PreferenceCategory>

</PreferenceScreen>
